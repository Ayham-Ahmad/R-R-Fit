{
  "name": "rr-fit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "R&R Fit - bilingual female fitness coaching SaaS",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --config vite.config.js",
    "thumbs": "node scripts/make_thumbs.mjs",
    "build": "node scripts/make_thumbs.mjs && node node_modules/vite/bin/vite.js build --config vite.config.js",
    "preview": "node node_modules/vite/bin/vite.js preview --config vite.config.js",
    "backend:setup": "node scripts/run_backend_py.mjs -m pip install -r backend/requirements.txt",
    "backend:validate": "node scripts/run_backend_py.mjs backend/scripts/verify_db.py --validate",
    "backend:validate:strict": "node scripts/run_backend_py.mjs backend/scripts/verify_db.py --validate --strict",
    "backend:apply": "node scripts/run_backend_py.mjs backend/scripts/verify_db.py --apply",
    "backend:seed": "node scripts/run_backend_py.mjs backend/scripts/verify_db.py --seed",
    "backend:bootstrap-admin": "node scripts/run_backend_py.mjs backend/scripts/verify_db.py --bootstrap-admin"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
