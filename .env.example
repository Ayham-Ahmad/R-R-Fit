# Frontend (safe for browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEFAULT_LANG=ar
VITE_DEFAULT_THEME=v1

# Backend scripts only. Never expose these in frontend code or VITE_* variables.
# Project URL used by verify_db.py (legacy browser alias: VITE_SUPABASE_URL).
SUPABASE_URL=

# Server-side key for structural validation and admin bootstrap.
# Legacy edge alias: SERVICE_ROLE_KEY. Never put this in a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# Optional read-only validation fallback. Legacy aliases: ANON_KEY,
# VITE_SUPABASE_ANON_KEY (browser-safe value only).
SUPABASE_ANON_KEY=

# Direct Postgres connection string. Required ONLY for backend:apply and
# backend:seed. Legacy alias: DATABASE_URL.
SUPABASE_DB_URL=

# Optional input for backend:bootstrap-admin. Prefer this or --password-stdin
# over the deprecated --password flag.
ADMIN_PASSWORD=

# Edge Functions (set in Supabase Edge Function secrets, not the browser bundle).
# Required for the scheduled proof cleanup; store the same value in Vault.
CLEANUP_SECRET=

# Optional new-format key map for edge functions (JSON object of name -> key).
# Legacy fallbacks: SUPABASE_SERVICE_ROLE_KEY / SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEYS=

# Edge Function secret for admin-users: comma-separated allowed browser origins.
APP_ORIGIN=
